          <mxGeometry x="330" y="760" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nodo_split" value="División de Datos&#xa;(Train / Test Split)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
